{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "change",
						"type": "DatasetReference"
					},
					"name": "sourceChange"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "fresh_changes",
						"type": "DatasetReference"
					},
					"name": "fresh"
				},
				{
					"dataset": {
						"referenceName": "aging_changes",
						"type": "DatasetReference"
					},
					"name": "aging"
				},
				{
					"dataset": {
						"referenceName": "stale_changes",
						"type": "DatasetReference"
					},
					"name": "stale"
				}
			],
			"transformations": [
				{
					"name": "derivedAge"
				},
				{
					"name": "conditionalSplit"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as short,",
				"          ch_id as string,",
				"          ch_changeId as string,",
				"          ch_changeIdNum as integer,",
				"          ch_project as string,",
				"          ch_branch as string,",
				"          ch_topic as string,",
				"          ch_authorAccountId as integer,",
				"          ch_createdTime as timestamp,",
				"          ch_updatedTime as timestamp,",
				"          ch_status as string,",
				"          ch_mergeable as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourceChange",
				"sourceChange derive(age_days = toInteger(minus(currentDate(), toDate(ch_createdTime)))) ~> derivedAge",
				"derivedAge split(age_days < 7,",
				"     and(age_days >= 7, age_days <= 30),",
				"     age_days > 30,",
				"     disjoint: false) ~> conditionalSplit@(fresh, aging, stale)",
				"conditionalSplit@fresh sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> fresh",
				"conditionalSplit@aging sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> aging",
				"conditionalSplit@stale sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> stale"
			]
		}
	}
}